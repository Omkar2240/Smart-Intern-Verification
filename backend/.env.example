# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trackintern

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email (dev mode = log to console)
EMAIL_ENABLED=false
